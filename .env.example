# Copy to .env and fill in. .env is gitignored; never commit real values.
# Firsthand only talks to the PayPal sandbox.
PAYPAL_ENV=sandbox

# Developer Dashboard → Apps & Credentials → your sandbox app (type: Merchant, linked to a US sandbox Business account)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Sandbox Personal accounts used as payout recipients by the probes (sandbox test accounts, not real people)
PAYPAL_SANDBOX_PAYOUT_EMAIL=
# Optional: a US phone number to test Venmo payouts in the sandbox
PAYPAL_SANDBOX_VENMO_PHONE=

# Local callback server used by probes that need a buyer to approve something in the browser
PROBE_PORT=5174
# Must match the Return URL configured under "Log in with PayPal" for the sandbox app
PAYPAL_LIPP_REDIRECT_URI=http://localhost:5174/callback

# Optional: TypeSafe Jev for System-1 entry screening (https://typesafe.ai)
TYPESAFE_API_KEY=
