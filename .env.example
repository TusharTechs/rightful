# Copy to .env and fill in. .env is gitignored; never commit real values.
# Rightful only talks to the PayPal sandbox.
PAYPAL_ENV=sandbox

# Developer Dashboard → Apps & Credentials → your sandbox app (type: Merchant, linked to a US sandbox Business account)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Sandbox Personal accounts used as payout recipients by the probes (sandbox test accounts, not real people)
PAYPAL_SANDBOX_PAYOUT_EMAIL=
# Optional: a US phone number to test Venmo payouts in the sandbox
PAYPAL_SANDBOX_VENMO_PHONE=

# Local callback server used by the login probe
PROBE_PORT=5174
# Log in with PayPal return URL. Must be public HTTPS and registered on the app (PayPal refuses
# localhost). Leave empty to derive it from the deployed URL: <RENDER_EXTERNAL_URL>/auth/paypal/callback
PAYPAL_LIPP_REDIRECT_URI=

# Optional: the ring investigator, TypeSafe Jev (https://typesafe.ai). Without a key, rings carry
# evidence only and `npm run eval:investigator` replays recorded answers.
TYPESAFE_API_KEY=
# Only when Jev is reached through a gateway that speaks the same API, e.g. https://api.venice.ai/api
TYPESAFE_BASE_URL=

# Scripts that drive a running API (open:program, pay:program)
RIGHTFUL_API=https://rightful-api.onrender.com
RIGHTFUL_ADMIN_TOKEN=
