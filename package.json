{
  "name": "firsthand",
  "version": "0.1.0",
  "description": "Fair, bot-proof ballots for scarce things. One verified PayPal human, one entry; only winners are charged.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/api/main.ts",
    "migrate": "tsx scripts/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "probe": "tsx --env-file-if-exists=.env scripts/probe.ts",
    "dev:api": "tsx --env-file-if-exists=.env src/api/main.ts",
    "demo:ballot": "tsx --env-file-if-exists=.env scripts/demo-ballot.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@hono/node-server": "^2.1.5",
    "@noble/hashes": "^2.4.0",
    "@typesafe-ai/sdk": "^0.7.0",
    "drand-client": "^1.4.2",
    "hono": "^4.13.13",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
