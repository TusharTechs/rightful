{
  "name": "rightful",
  "version": "0.1.0",
  "description": "Settlement and refund payouts that claim farms cannot drain: one claim per verified PayPal account, a public ledger before any money moves, payment only to the account that signed in.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/api/main.ts",
    "migrate": "tsx scripts/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "probe": "tsx --env-file-if-exists=.env scripts/probe.ts",
    "webhook:register": "tsx --env-file-if-exists=.env scripts/register-webhook.ts",
    "dev:api": "tsx --env-file-if-exists=.env src/api/main.ts",
    "clock": "tsx scripts/clock.ts",
    "dev:web": "vite",
    "build:web": "vite build",
    "preview:web": "vite preview",
    "dev:api:fake": "tsx scripts/dev-fake.ts",
    "eval:rings": "tsx scripts/eval-rings.ts",
    "open:program": "tsx --env-file-if-exists=.env scripts/open-program.ts",
    "pay:program": "tsx --env-file-if-exists=.env scripts/pay-program.ts",
    "eval:investigator": "tsx --env-file-if-exists=.env scripts/eval-investigator.ts",
    "demo": "tsx --env-file-if-exists=.env scripts/demo.ts"
  },
  "dependencies": {
    "@bryntum/core-community": "8.0.0",
    "@bryntum/engine-community": "8.0.0",
    "@bryntum/grid-community": "8.0.0",
    "@bryntum/scheduler-community": "8.0.0",
    "@electric-sql/pglite": "^0.5.11",
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@noble/hashes": "^2.4.0",
    "@typesafe-ai/sdk": "^0.7.0",
    "ag-grid-community": "36.2.0",
    "ag-grid-react": "36.2.0",
    "drand-client": "^1.4.2",
    "hono": "^4.13.13",
    "paypal": "git+https://github.com/context-plugins/paypal-typescript-sdk.git#5d0df8a8817e5fdf2e2cd48e68f790ea4730aab2",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
